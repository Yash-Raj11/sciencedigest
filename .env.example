# Copy this file to .env.local and fill it in. .env.local is never committed.
#
# With NOTHING filled in the app runs in demo mode: it works, and everything a
# visitor ticks stays on their own device. Fill in the first two to go live.

# --- Supabase (the database and sign-in). Manual, part 3. --------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- CAPTCHA on the first (anonymous) sign-in: Cloudflare Turnstile. ----------
# Cloudflare dashboard -> Turnstile -> Add widget (mode: Invisible; hostnames:
# your live domain, plus localhost to try it under `npm run dev`). Copy the
# SITE key here. It is public: it ends up in the page.
# Leave it empty and sign-in works without CAPTCHA (local dev, demo mode).
# The SECRET key never goes in this file: paste it into Supabase ->
# Authentication -> Attack Protection, and only AFTER this site key is live.
# Order and reasons: docs/MANUAL.md, part 3.1.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side only. NEVER prefix with NEXT_PUBLIC_: this key bypasses every
# access rule. Used by `npm run retractions` to withdraw a retracted paper.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI model for the paper pipeline. Manual, part 5. ------------------------
# Only needed on your own machine, to run `npm run paper -- extract|draft`.
AI_API_KEY=
AI_MODEL_EXTRACT=claude-opus-5-5
AI_MODEL_EDITORIAL=claude-opus-5-5
# AI_BASE_URL=https://api.anthropic.com
